#include <iostream>
#include <string>
using namespace std;

class Employee
{
public:
    string name;
    int id;
    int age;
    string department;
    float salary;

    void input()
    {
        cout << "Enter employee name: ";
        cin >> name;

        cout << "Enter employee ID: ";
        cin >> id;

        cout << "Enter employee age: ";
        cin >> age;

        cout << "Enter department: ";
        cin >> department;

        cout << "Enter salary: ";
        cin >> salary;
    }

    void display()
    {
        cout << "\n----- Employee Details -----" << endl;
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
        cout << "Age: " << age << endl;
        cout << "Department: " << department << endl;
        cout << "Salary: " << salary << endl;
    }
};

int main()
{
    Employee e;

    e.input();
    e.display();

    return 0;
}
