#include <iostream>
#include <iomanip>
using namespace std;

class Time
{
public:
    int totalSeconds;
    int hours;
    int minutes;
    int seconds;

    void input()
    {
        cout << "Enter total seconds: ";
        cin >> totalSeconds;
    }

    void convert()
    {
        hours = totalSeconds / 3600;
        minutes = (totalSeconds % 3600) / 60;
        seconds = totalSeconds % 60;
    }

    void display()
    {
        cout << "Time: "
             << setfill('0') << setw(2) << hours << ":"
             << setw(2) << minutes << ":"
             << setw(2) << seconds << endl;
    }
};

int main()
{
    Time t;

    t.input();
    t.convert();
    t.display();

    return 0;
}
